WEBHOOK = 'https://discord.com/api/webhooks/example'
#APPID AND HASH https://core.telegram.org/api/obtaining_api_id
APPID = "123" 
APIHASH = "bcdddexample123123" #
APINAME = "Telegram To Discord" # Any string will do
DLLOC = './temp/' # Temp storage for media, inside the working directory; must exist before starting

## Filter Channels Examples
# You can get ID's from the URL's https://web.telegram.org/
#INPUT_CHANNELS = 12
#INPUT_CHANNELS = 13,14

## MAX (https://dev.max.ru) channel target — enabled when both are set
# Bot token: MAX platform -> Chat bots -> your bot -> Settings. The bot must be a channel admin.
#MAX_TOKEN = "..."
# Channel chat_id: run `python3 tools/max_chat_id.py`, then post something in the channel.
#MAX_CHAT_ID = -1234567890
# Only if the Russian Ministry of Digital Development root CA is not in the system store:
#MAX_CA_FILE = /path/to/russian_trusted_root_ca.pem


## VK community wall target — enabled when both are set
# Community access key: Manage -> API usage -> Access tokens. Rights: wall, photos, messages
# (photos are uploaded through the messages route; a community key can't upload video).
#VK_TOKEN = "..."
# Community id, digits only (no minus). Check what the key can do: python3 tools/vk_check.py
#VK_GROUP_ID = 123456
# Only if the system trust store can't verify api.vk.com:
#VK_CA_FILE = /path/to/cacert.pem
