WEBHOOK = 'https://discord.com/api/webhooks/example'
#APPID AND HASH https://core.telegram.org/api/obtaining_api_id
APPID = "123" 
APIHASH = "bcdddexample123123" #
APINAME = "Telegram To Discord" # Any string will do
DLLOC = './temp/' # Temp storage for media, inside the working directory; must exist before starting

## Filter Channels Examples
# You can get ID's from the URL's https://web.telegram.org/
#INPUT_CHANNELS = 12
#INPUT_CHANNELS = 13,14

## MAX (https://dev.max.ru) channel target — enabled when both are set
# Bot token: MAX platform -> Chat bots -> your bot -> Settings. The bot must be a channel admin.
#MAX_TOKEN = "..."
# Channel chat_id: run `python3 tools/max_chat_id.py`, then post something in the channel.
#MAX_CHAT_ID = -1234567890
# Only if the Russian Ministry of Digital Development root CA is not in the system store:
#MAX_CA_FILE = /path/to/russian_trusted_root_ca.pem


## VK community wall target — enabled when VK_TOKEN and VK_GROUP_ID are set.
# The community key publishes posts (text). Photos/video additionally need an admin's
# user token from VK ID, since a community key can't upload media: set VK_APP_ID and run
# python3 tools/vk_user_auth.py (creates vk_user_token.json, keep it on ONE machine).
# Without it media is replaced by a link to the original Telegram post.
# Community access key: Manage -> API usage -> Access tokens. Right needed: wall.
#VK_TOKEN = "..."
# Community id, digits only (no minus). Check what the keys can do: python3 tools/vk_check.py
#VK_GROUP_ID = 123456
#VK_APP_ID = 12345678
# Trusted redirect URL of the VK app (platform Web: base domain localhost, redirect https://localhost):
#VK_REDIRECT_URI = "https://localhost"
# Only if VK ID says the app is confidential: the app's service key
#VK_SERVICE_TOKEN = "..."
# Only if the system trust store can't verify api.vk.com (path must exist on THIS machine):
#VK_CA_FILE = /path/to/cacert.pem


## Tumblr blog target — enabled when the three are set and tumblr_token.json exists
# Register an app at https://www.tumblr.com/oauth/apps, then run: python3 tools/tumblr_auth.py
#TUMBLR_CLIENT_ID = "..."
#TUMBLR_CLIENT_SECRET = "..."
#TUMBLR_BLOG = "myblog"   # or myblog.tumblr.com
# Must match the redirect URL registered in the app (default https://localhost/callback):
#TUMBLR_REDIRECT_URI = "https://localhost/callback"
#TUMBLR_TOKEN_FILE = tumblr_token.json

## Polls: how a Telegram poll goes to the other platforms (votes are never synced)
# link   (default) the question and a link to vote in Telegram
# list   the question, the options and the link
# native a real poll on Threads and Discord (each counts its own votes), 'list' text elsewhere
#POLL_MODE = link

## Threads target — enabled when THREADS_APP_ID is set (and tools/threads_auth.py made the token)
# Meta app (developers.facebook.com, Threads API): the profile to post to must be a "Threads Tester".
#THREADS_APP_ID = "..."
#THREADS_APP_SECRET = "..."        # only for tools/threads_auth.py
#THREADS_REDIRECT_URI = "https://localhost/"
# Threads fetches pictures and videos from public URLs, so media goes through a small public
# folder: SFTP-only account + nginx location. Without these three the post is text + link.
#THREADS_MEDIA_SFTP = threadsbot@slona.me
#THREADS_MEDIA_KEY = /home/slona/.ssh/threads_upload
#THREADS_MEDIA_URL = https://slona.me/tmp-threads/
# Long posts become a chain of replies (permission threads_manage_replies); with ffmpeg installed
# (apt install ffmpeg) media Threads wouldn't take is converted first. Optional: FFMPEG_BIN / FFPROBE_BIN.
# Verify everything without publishing: python3 tools/threads_check.py
